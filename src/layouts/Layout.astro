---
// Master Layout for Slise.Dev // 3D Particle & AI Multi-Agent Portfolio
import '../styles/global.css';
import HeaderNav from '../components/HeaderNav.astro';
import ReactorCanvas from '../components/ReactorCanvas.astro';
import HudFrame from '../components/HudFrame.astro';
import CustomCursor from '../components/CustomCursor.astro';
import InteractiveEngineering from '../components/InteractiveEngineering.astro';
import { personalData } from '../data/cv.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${personalData.fullName} (${personalData.alias}) — Desarrollo Web, Apps Móviles & IA`,
  description = personalData.valueProposition
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={personalData.fullName} />

  <!-- Open Graph / WhatsApp & LinkedIn Share Preview -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://slisedevporfolio.vercel.app/" />
  <meta property="og:image" content="https://slisedevporfolio.vercel.app/assets/img/my-profile-img.jpeg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}assets/img/favicon.png`} />
  
  <!-- Preconnect Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>
  <!-- 2026 Skill Signature Effects: Ambient Mesh & Interactive Physics -->
  <InteractiveEngineering />

  <!-- 2026 Skill Signature Effect: Two-Circle Telemetry Custom Cursor -->
  <CustomCursor />

  <!-- 3D Particle Sculpture Morphing Engine -->
  <ReactorCanvas />

  <!-- Persistent Holographic HUD Overlays & Telemetry -->
  <HudFrame />

  <!-- Glassmorphic Navbar -->
  <HeaderNav />

  <!-- Main Content Slot -->
  <main class="main-content">
    <slot />
  </main>

  <!-- Floating WhatsApp Quick-Action Pill -->
  <a
    href={personalData.whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-wa-pill"
    aria-label="Contactar a Steven por WhatsApp"
    data-magnetic
    data-magnetic-strength="0.22"
  >
    <span class="wa-pulse-dot"></span>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.494 5.457 5.643-1.48c1.9.997 4.063 1.565 6.367 1.565 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
    </svg>
    <span class="wa-pill-text">WhatsApp Directo</span>
  </a>

  <!-- Futuristic Footer -->
  <footer class="hud-footer">
    <div class="jarvis-container footer-container">
      <div class="footer-left">
        <span class="footer-brand">SLISE.DEV // {personalData.fullName.toUpperCase()}</span>
        <span class="footer-sub">Ingeniero de Software &bull; {personalData.location} &bull; {personalData.phone}</span>
      </div>
      <div class="footer-right">
        <span class="footer-status">DISPONIBLE PARA NUEVOS PROYECTOS [100%]</span>
        <span class="footer-alias">FULL STACK &bull; MOBILE &bull; INTELIGENCIA ARTIFICIAL</span>
      </div>
    </div>
  </footer>

  <style>
    .main-content {
      position: relative;
      z-index: 2;
    }

    /* Floating WhatsApp Button */
    .floating-wa-pill {
      position: fixed;
      bottom: 24px;
      right: 26px;
      z-index: 1050;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: rgba(5, 22, 18, 0.92);
      border: 1.5px solid #10b981;
      color: #ffffff !important;
      padding: 11px 18px;
      border-radius: 999px;
      font-family: var(--font-hud);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.8px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.75), 0 0 22px rgba(16, 185, 129, 0.4);
      backdrop-filter: blur(12px);
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .floating-wa-pill:hover {
      background: #10b981;
      color: #020612 !important;
      box-shadow: 0 0 32px rgba(16, 185, 129, 0.85);
      transform: translateY(-3px);
    }
    .floating-wa-pill svg {
      color: #10b981;
      transition: color 0.25s ease;
    }
    .floating-wa-pill:hover svg {
      color: #020612;
    }
    .wa-pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 10px #10b981;
      animation: pulse-glow 1.8s infinite;
    }

    .hud-footer {
      border-top: 1px solid var(--jarvis-border);
      background: rgba(2, 5, 14, 0.96);
      backdrop-filter: blur(14px);
      padding: 30px 0;
      position: relative;
      z-index: 2;
      font-family: var(--font-tech);
    }
    .footer-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }
    .footer-left {
      display: flex;
      flex-direction: column;
    }
    .footer-brand {
      color: #ffffff;
      font-family: var(--font-hud);
      font-size: 13px;
      letter-spacing: 1.5px;
      font-weight: 700;
    }
    .footer-sub {
      color: var(--jarvis-text-muted);
      font-size: 11px;
      margin-top: 2px;
    }
    .footer-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }
    .footer-status {
      color: #10b981;
      font-size: 11px;
      letter-spacing: 1px;
    }
    .footer-alias {
      color: var(--jarvis-text-muted);
      font-size: 10px;
    }

    @media (max-width: 768px) {
      .footer-right {
        align-items: flex-start;
      }
      .floating-wa-pill {
        bottom: 16px;
        right: 16px;
        padding: 10px 15px;
      }
      .wa-pill-text {
        font-size: 10.5px;
      }
    }
  </style>
</body>
</html>
