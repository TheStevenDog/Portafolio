---
// Contact Section (Inspired by 00:15-00:18 of Video.mp4 "work with us / hello@..." + WhatsApp Lead Engine)
import { personalData } from '../data/cv.js';
---

<section id="contact" class="jarvis-section contact-section">
  <div class="jarvis-container">

    <!-- Giant Editorial Hero-Style Contact Banner (Like 00:16 of Video.mp4) -->
    <div class="editorial-contact-hero">
      <span class="work-with-us-label">// ¿TIENES UNA IDEA O PROYECTO EN MENTE?</span>
      <h2 class="editorial-contact-heading">
        <span class="heading-outline">TRABAJEMOS</span>
        <span class="heading-solid">JUNTOS.</span>
      </h2>

      <div class="giant-links-stack">
        <a
          href={personalData.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="giant-contact-link whatsapp-giant"
        >
          <span class="giant-tag">WHATSAPP DIRECTO</span>
          <span class="giant-value">{personalData.phone} &#8599;</span>
        </a>

        <a href={personalData.socials.email} class="giant-contact-link email-giant">
          <span class="giant-tag">CORREO ELECTRÓNICO</span>
          <span class="giant-value">{personalData.email} &#8599;</span>
        </a>
      </div>
    </div>

    <div class="contact-grid">
      <!-- Info & Direct Channels Card -->
      <div class="hud-card contact-info-card">
        <div class="hud-card-header">
          <span>[DIRECT_CHANNELS // SLISE.DEV]</span>
          <span class="jarvis-badge jarvis-badge-emerald">RESPUESTA RÁPIDA</span>
        </div>

        <h3 class="contact-info-title">Canales Directos</h3>
        <p class="contact-lead-text">
          Elige el canal que prefieras. Respondo personalmente por WhatsApp o correo para evaluar tu proyecto y proponerte la mejor solución técnica.
        </p>

        <div class="contact-items-list">
          <a href={personalData.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-item highlight-wa-item">
            <div class="contact-icon wa-icon">💬</div>
            <div class="contact-detail">
              <span class="contact-label">WHATSAPP OFICIAL (RECOMENDADO)</span>
              <span class="contact-val">{personalData.phone} &bull; Iniciar Chat &#8599;</span>
            </div>
          </a>

          <a href={personalData.socials.email} class="contact-item">
            <div class="contact-icon">✉️</div>
            <div class="contact-detail">
              <span class="contact-label">CORREO ELECTRÓNICO</span>
              <span class="contact-val link-bright">{personalData.email}</span>
            </div>
          </a>

          <a href={personalData.socials.github} target="_blank" rel="noopener noreferrer" class="contact-item">
            <div class="contact-icon">🐙</div>
            <div class="contact-detail">
              <span class="contact-label">GITHUB OFICIAL</span>
              <span class="contact-val link-bright">github.com/{personalData.githubHandle} ({personalData.alias})</span>
            </div>
          </a>

          <a href={personalData.socials.linkedin} target="_blank" rel="noopener noreferrer" class="contact-item">
            <div class="contact-icon">💼</div>
            <div class="contact-detail">
              <span class="contact-label">LINKEDIN PROFESIONAL</span>
              <span class="contact-val link-bright">Steven Rueda Lopez &#8599;</span>
            </div>
          </a>

          <div class="contact-item">
            <div class="contact-icon">📍</div>
            <div class="contact-detail">
              <span class="contact-label">UBICACIÓN BASE</span>
              <span class="contact-val">{personalData.location} &bull; Disponible Remoto</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Smart Brief Form (Sends straight to WhatsApp or Email) -->
      <div class="hud-card contact-form-card">
        <div class="hud-card-header">
          <span>[PROJECT_BRIEF // TRANSMITTER]</span>
          <span class="jarvis-badge jarvis-badge-cyan">CONEXIÓN DIRECTA</span>
        </div>

        <h3 class="contact-info-title">Cuéntame sobre tu Proyecto</h3>

        <form id="jarvis-contact-form" class="cyber-form">
          <div class="form-row">
            <div class="form-group">
              <label for="client-name" class="form-label">Tu Nombre o Empresa</label>
              <input type="text" id="client-name" name="name" class="form-input" placeholder="Ej: Carlos Gómez / Mi Empresa" required />
            </div>

            <div class="form-group">
              <label for="client-service" class="form-label">¿Qué necesitas construir?</label>
              <select id="client-service" name="service" class="form-input">
                <option value="Desarrollo Web / Plataforma Full Stack">Desarrollo Web / Plataforma Full Stack</option>
                <option value="Aplicación Móvil (Google Play Store)">Aplicación Móvil (Google Play Store)</option>
                <option value="Automatización con Inteligencia Artificial">Automatización con Inteligencia Artificial</option>
                <option value="Landing Page de Alta Conversión">Landing Page de Alta Conversión</option>
                <option value="Optimización / Backend / API">Optimización / Backend / API</option>
                <option value="Otro Proyecto o Consultoría">Otro Proyecto o Consultoría</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="client-message" class="form-label">Detalles o Idea del Proyecto</label>
            <textarea id="client-message" name="body" rows="5" class="form-textarea" placeholder="Cuéntame brevemente qué quieres lograr con tu proyecto..." required></textarea>
          </div>

          <div class="form-submit-group">
            <button type="submit" id="send-wa-btn" class="jarvis-btn jarvis-btn-whatsapp-submit w-full">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.494 5.457 5.643-1.48c1.9.997 4.063 1.565 6.367 1.565 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span>Enviar Mensaje Directo a WhatsApp</span>
            </button>

            <button type="button" id="send-email-btn" class="jarvis-btn jarvis-btn-outline w-full">
              <span>O Enviar por Correo Electrónico</span>
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</section>

<style>
  /* Giant Editorial Contact Showcase (00:16 Video.mp4) */
  .editorial-contact-hero {
    margin-bottom: 52px;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(0, 240, 255, 0.2);
  }

  .work-with-us-label {
    font-family: var(--font-tech);
    font-size: 13px;
    letter-spacing: 2.5px;
    color: #ffbe0b;
    display: block;
    margin-bottom: 10px;
  }

  .editorial-contact-heading {
    font-family: var(--font-hud);
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    font-weight: 900;
    line-height: 1;
    margin-bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .heading-outline {
    color: transparent;
    -webkit-text-stroke: 1.6px rgba(240, 247, 255, 0.85);
  }

  .heading-solid {
    color: #ffffff;
  }

  .giant-links-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .giant-contact-link {
    display: inline-flex;
    flex-direction: column;
    padding: 16px 24px;
    background: rgba(4, 12, 28, 0.78);
    border: 1px solid rgba(0, 240, 255, 0.28);
    border-radius: 8px;
    backdrop-filter: blur(12px);
    max-width: fit-content;
    transition: all 0.3s ease;
  }
  .giant-contact-link.whatsapp-giant {
    border-color: rgba(16, 185, 129, 0.55);
    background: rgba(16, 185, 129, 0.08);
  }
  .giant-contact-link.whatsapp-giant:hover {
    border-color: #10b981;
    box-shadow: 0 0 30px rgba(16, 185, 129, 0.35);
    transform: translateX(6px);
  }
  .giant-contact-link.email-giant:hover {
    border-color: #ffbe0b;
    box-shadow: 0 0 30px rgba(255, 190, 11, 0.28);
    transform: translateX(6px);
  }

  .giant-tag {
    font-family: var(--font-tech);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--jarvis-text-muted);
    margin-bottom: 4px;
  }

  .giant-value {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 2.25rem);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.5px;
    word-break: break-all;
  }

  /* Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 28px;
  }

  .contact-info-title {
    font-size: 20px;
    color: #ffffff;
    margin-bottom: 10px;
    letter-spacing: 1px;
  }

  .contact-lead-text {
    font-size: 14px;
    color: var(--jarvis-text-muted);
    margin-bottom: 22px;
    line-height: 1.65;
  }

  .contact-items-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(0, 240, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.2);
    padding: 13px 16px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .contact-item:hover {
    border-color: var(--jarvis-cyan);
    background: rgba(0, 240, 255, 0.09);
    transform: translateX(4px);
  }
  .contact-item.highlight-wa-item {
    border-color: rgba(16, 185, 129, 0.55);
    background: rgba(16, 185, 129, 0.1);
  }
  .contact-item.highlight-wa-item:hover {
    border-color: #10b981;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.28);
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid var(--jarvis-border);
    border-radius: 6px;
    font-size: 18px;
    flex-shrink: 0;
  }
  .wa-icon {
    background: rgba(16, 185, 129, 0.2);
    border-color: #10b981;
  }

  .contact-detail {
    display: flex;
    flex-direction: column;
  }
  .contact-label {
    font-family: var(--font-tech);
    font-size: 10px;
    color: var(--jarvis-cyan);
    letter-spacing: 1px;
    margin-bottom: 2px;
  }
  .highlight-wa-item .contact-label {
    color: #10b981;
  }
  .contact-val {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    word-break: break-all;
  }

  /* Cyber Form */
  .cyber-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 14px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    font-family: var(--font-tech);
    font-size: 11px;
    color: var(--jarvis-cyan);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .form-input,
  .form-textarea {
    background: rgba(2, 8, 20, 0.92);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 14px;
    padding: 12px 14px;
    border-radius: 4px;
    transition: all 0.25s ease;
  }
  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #ffbe0b;
    box-shadow: 0 0 15px rgba(255, 190, 11, 0.25);
  }

  .form-submit-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .jarvis-btn-whatsapp-submit {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff !important;
    box-shadow: 0 0 22px rgba(16, 185, 129, 0.45);
  }
  .jarvis-btn-whatsapp-submit:hover {
    background: #ffffff;
    color: #047857 !important;
    box-shadow: 0 0 30px rgba(16, 185, 129, 0.8);
  }

  .w-full {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initContactTransmitter() {
    const form = document.getElementById('jarvis-contact-form') as HTMLFormElement | null;
    const emailBtn = document.getElementById('send-email-btn');
    if (!form) return;

    function getFormValues() {
      const name = (document.getElementById('client-name') as HTMLInputElement | null)?.value.trim() || 'Cliente';
      const service = (document.getElementById('client-service') as HTMLSelectElement | null)?.value || 'Proyecto de Software';
      const message = (document.getElementById('client-message') as HTMLTextAreaElement | null)?.value.trim() || 'Me gustaría cotizar un proyecto.';
      return { name, service, message };
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const { name, service, message } = getFormValues();
      const text = `Hola Steven 👋, soy *${name}*.\n\nMe interesa: *${service}*\n\nDetalles: ${message}`;
      const waUrl = `https://wa.me/573015417816?text=${encodeURIComponent(text)}`;
      window.open(waUrl, '_blank', 'noopener,noreferrer');
    });

    if (emailBtn) {
      emailBtn.addEventListener('click', () => {
        const { name, service, message } = getFormValues();
        const subject = encodeURIComponent(`Propuesta de Proyecto: ${service} - ${name}`);
        const body = encodeURIComponent(`Hola Steven,\n\nSoy ${name}.\nServicio de interés: ${service}\n\nDetalles del proyecto:\n${message}`);
        window.location.href = `mailto:steven2902rueda2902@gmail.com?subject=${subject}&body=${body}`;
      });
    }
  }

  if (typeof window !== 'undefined') {
    initContactTransmitter();
    document.addEventListener('astro:page-load', initContactTransmitter);
  }
</script>
