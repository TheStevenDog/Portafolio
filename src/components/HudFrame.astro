---
// Persistent Holographic HUD Telemetry & Audio Controller
---

<!-- Corner HUD Brackets -->
<div class="hud-overlay-frame" aria-hidden="true">
  <div class="hud-bracket hud-tl"></div>
  <div class="hud-bracket hud-tr"></div>
  <div class="hud-bracket hud-bl"></div>
  <div class="hud-bracket hud-br"></div>
</div>

<!-- Bottom Right Assembly & Sector Telemetry -->
<div class="hud-telemetry-gauge">
  <div class="gauge-header">
    <span class="gauge-label">SYS.ASSEMBLY</span>
    <span id="hud-assembly-val" class="gauge-value">0%</span>
  </div>
  <div class="gauge-track">
    <div id="hud-assembly-bar" class="gauge-fill"></div>
  </div>
  <div class="gauge-footer">
    <span id="hud-sector-indicator">SEC 00 // BOOT SEQUENCE</span>
    <span id="hud-z-index">Z: 1000</span>
  </div>
</div>

<style>
  .hud-overlay-frame {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 900;
  }

  .hud-bracket {
    position: fixed;
    width: 28px;
    height: 28px;
    border-color: var(--jarvis-cyan);
    border-style: solid;
    opacity: 0.65;
    transition: all 0.3s ease;
  }
  .hud-tl {
    top: 14px;
    left: 14px;
    border-width: 2.5px 0 0 2.5px;
  }
  .hud-tr {
    top: 14px;
    right: 14px;
    border-width: 2.5px 2.5px 0 0;
  }
  .hud-bl {
    bottom: 14px;
    left: 14px;
    border-width: 0 0 2.5px 2.5px;
  }
  .hud-br {
    bottom: 14px;
    right: 14px;
    border-width: 0 2.5px 2.5px 0;
  }

  .hud-telemetry-gauge {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 950;
    background: rgba(3, 10, 26, 0.88);
    border: 1px solid var(--jarvis-border);
    backdrop-filter: blur(12px);
    padding: 10px 16px;
    border-radius: 6px;
    font-family: var(--font-tech);
    min-width: 210px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
  }
  .gauge-header {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 700;
    color: var(--jarvis-cyan);
    margin-bottom: 5px;
  }
  .gauge-track {
    width: 100%;
    height: 5px;
    background: rgba(0, 240, 255, 0.15);
    border-radius: 3px;
    overflow: hidden;
  }
  .gauge-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, var(--jarvis-blue), var(--jarvis-cyan));
    box-shadow: 0 0 8px var(--jarvis-cyan);
    transition: width 0.15s ease-out;
  }
  .gauge-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 5px;
    font-size: 10px;
    color: var(--jarvis-text-muted);
  }

  @media (max-width: 768px) {
    .hud-telemetry-gauge {
      display: none;
    }
    .hud-bracket {
      display: none;
    }
  }
</style>

<script>
  function setupHudTracking() {
    const assemblyVal = document.getElementById('hud-assembly-val');
    const assemblyBar = document.getElementById('hud-assembly-bar');
    const zIndexEl = document.getElementById('hud-z-index');
    const sectorEl = document.getElementById('hud-sector-indicator');

    const sectors = [
      { id: 'hero', name: 'SEC 00 // BOOT SEQUENCE' },
      { id: 'about', name: 'SEC 01 // BIOMETRICS & PERFIL' },
      { id: 'skills', name: 'SEC 02 // TECHNICAL MATRIX' },
      { id: 'projects', name: 'SEC 03 // GITHUB BLUEPRINTS' },
      { id: 'experience', name: 'SEC 04 // MISSION TIMELINE' },
      { id: 'contact', name: 'SEC 05 // SATELLITE LINK' }
    ];

    function update() {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(Math.round((scrollY / docHeight) * 100), 100) : 0;

      if (assemblyVal) assemblyVal.textContent = pct + '%';
      if (assemblyBar) assemblyBar.style.width = pct + '%';
      if (zIndexEl) zIndexEl.textContent = 'Z: ' + (1000 + Math.round(scrollY * 0.4));

      const middleY = scrollY + window.innerHeight * 0.35;
      for (let i = sectors.length - 1; i >= 0; i--) {
        const el = document.getElementById(sectors[i].id);
        if (el && middleY >= el.offsetTop) {
          if (sectorEl && sectorEl.textContent !== sectors[i].name) {
            sectorEl.textContent = sectors[i].name;
          }
          break;
        }
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  if (typeof window !== 'undefined') {
    setupHudTracking();
    document.addEventListener('astro:page-load', setupHudTracking);
  }
</script>
