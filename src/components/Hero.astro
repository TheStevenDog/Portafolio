---
// Hero Section: Editorial 3D Style (WSTA Reference) + Global Multi-Agent Targets
import { personalData } from '../data/cv.js';
---

<section id="hero" class="hero-section" data-hero-builder>
  <div class="jarvis-container hero-container">
    <div class="hero-content">

      <!-- Top Bar: Identity Badge + Global Agent Replay Controller -->
      <div class="hero-top-bar">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>SLISE.DEV // {personalData.fullName.toUpperCase()}</span>
        </div>

        <button type="button" id="replay-agents-btn" class="agent-replay-pill" title="Ver a los agentes IA construir toda la página en vivo">
          <span class="replay-spark">⚡</span>
          <span id="replay-agents-label">Agentes IA: Construyendo...</span>
        </button>
      </div>

      <!-- Giant Editorial Display Headline (Inspired by 00:01 Video.mp4 "BOOST YOUR BRAND") -->
      <div class="hero-headline-wrap" data-build-part="headline" data-blueprint-label="H1 // EDITORIAL_DISPLAY [780×210]">
        <h1 class="hero-editorial-title">
          <span class="title-stroke">IMPULSA</span>
          <span class="title-solid">TU NEGOCIO</span>
          <span class="title-accent">CON IA &amp; SOFTWARE.</span>
        </h1>
      </div>

      <!-- Dynamic Specialty Line -->
      <div class="hero-typer-line" data-build-part="typer" data-blueprint-label="ROLE // ACTIVE_MODULE">
        <span class="typer-prefix">// Especialista en:</span>
        <span id="hero-typewriter" class="typer-dynamic">Aplicaciones Web &amp; Plataformas Full Stack</span>
        <span class="typer-cursor"></span>
      </div>

      <!-- Client-Oriented Value Proposition -->
      <div class="hero-summary-wrap" data-build-part="summary" data-blueprint-label="COPY // VALUE_PROPOSITION">
        <p class="hero-summary">
          Soy <strong>{personalData.fullName}</strong>, Ingeniero de Software en Medellín. Diseño y construyo <strong>aplicaciones web modernas</strong>, <strong>apps móviles en Google Play Store</strong> y sistemas de <strong>automatización con Inteligencia Artificial</strong> que optimizan operaciones y convierten visitantes en <strong>clientes reales</strong>.
        </p>
      </div>

      <!-- Proof & Credibility Metrics -->
      <div class="hero-telemetry-grid" data-build-part="metrics" data-blueprint-label="PROOF // VERIFIED_METRICS">
        <div class="telemetry-box highlight-gold">
          <span class="telemetry-label">RECONOCIMIENTO NACIONAL</span>
          <span class="telemetry-val">Top 3 Hackathon IA MinTic</span>
        </div>
        <div class="telemetry-box">
          <span class="telemetry-label">PRODUCTO EN TIENDA OFICIAL</span>
          <span class="telemetry-val">App en Google Play Store</span>
        </div>
        <div class="telemetry-box highlight-emerald">
          <span class="telemetry-label">DISPONIBILIDAD</span>
          <span class="telemetry-val">Proyectos &amp; Consultoría</span>
        </div>
      </div>

      <!-- High-Conversion CTA Group (WhatsApp + Projects + Services) -->
      <div class="hero-actions" data-build-part="actions" data-blueprint-label="CTA // CONVERSION_NODES">
        <a
          href={personalData.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="jarvis-btn jarvis-btn-whatsapp"
          id="hero-primary-cta"
          data-magnetic
          data-magnetic-strength="0.28"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.494 5.457 5.643-1.48c1.9.997 4.063 1.565 6.367 1.565 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span>Hablemos por WhatsApp</span>
        </a>

        <a href="#projects" class="jarvis-btn jarvis-btn-primary" data-magnetic data-magnetic-strength="0.28">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>Ver Proyectos Reales</span>
        </a>

        <a href="#services" class="jarvis-btn jarvis-btn-outline" data-magnetic data-magnetic-strength="0.28">
          <span>Qué Puedo Crear Para Ti</span>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: 108px;
    padding-bottom: 64px;
    z-index: 2;
    overflow: hidden;
  }

  .hero-container {
    position: relative;
    z-index: 3;
  }

  .hero-content {
    max-width: 740px;
  }

  /* Top Bar */
  .hero-top-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 22px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.35);
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-tech);
    font-size: 11px;
    color: var(--jarvis-cyan);
    letter-spacing: 2px;
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--jarvis-cyan);
    box-shadow: 0 0 10px var(--jarvis-cyan);
    animation: pulse-glow 2s infinite;
  }

  .agent-replay-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 190, 11, 0.1);
    border: 1px solid rgba(255, 190, 11, 0.45);
    color: #ffbe0b;
    font-family: var(--font-tech);
    font-size: 11px;
    letter-spacing: 1px;
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .agent-replay-pill:hover {
    background: #ffbe0b;
    color: #020612;
    box-shadow: 0 0 18px rgba(255, 190, 11, 0.6);
  }

  /* Editorial Giant Title */
  .hero-headline-wrap {
    position: relative;
    margin-bottom: 18px;
  }

  .hero-editorial-title {
    display: flex;
    flex-direction: column;
    font-family: var(--font-hud);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }

  .title-stroke {
    font-size: clamp(2.8rem, 6.5vw, 5.2rem);
    color: transparent;
    -webkit-text-stroke: 1.8px rgba(240, 247, 255, 0.85);
    letter-spacing: 2px;
    transition: all 0.4s ease;
  }

  .title-solid {
    font-size: clamp(3rem, 7vw, 5.6rem);
    color: #ffffff;
    text-shadow: 0 10px 35px rgba(0, 0, 0, 0.8);
    letter-spacing: 1px;
  }

  .title-accent {
    font-size: clamp(1.75rem, 3.8vw, 3.1rem);
    background: linear-gradient(90deg, #ffbe0b 0%, #00f0ff 90%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-top: 6px;
    letter-spacing: 1px;
  }

  /* Typer Line */
  .hero-typer-line {
    font-family: var(--font-tech);
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    flex-wrap: wrap;
    background: rgba(4, 14, 30, 0.78);
    padding: 8px 16px;
    border-radius: 6px;
    border-left: 3px solid #ffbe0b;
  }
  .typer-prefix {
    color: var(--jarvis-text-muted);
  }
  .typer-dynamic {
    color: #ffbe0b;
    font-weight: 700;
  }
  .typer-cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: #ffbe0b;
    animation: pulse-glow 0.8s infinite;
  }

  /* Editorial Value Proposition */
  .hero-summary-wrap {
    position: relative;
    margin-bottom: 28px;
  }
  .hero-summary {
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    color: rgba(226, 238, 255, 0.88);
    line-height: 1.75;
    max-width: 650px;
  }
  .hero-summary strong {
    color: #ffffff;
    font-weight: 700;
    border-bottom: 1px dashed rgba(0, 240, 255, 0.45);
  }

  /* Telemetry Proof Grid */
  .hero-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }
  .telemetry-box {
    background: rgba(5, 14, 32, 0.82);
    border: 1px solid rgba(0, 240, 255, 0.25);
    backdrop-filter: blur(12px);
    padding: 13px 16px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }
  .telemetry-box.highlight-gold {
    border-color: rgba(255, 190, 11, 0.55);
    background: rgba(255, 190, 11, 0.07);
  }
  .telemetry-box.highlight-emerald {
    border-color: rgba(16, 185, 129, 0.55);
    background: rgba(16, 185, 129, 0.07);
  }
  .telemetry-label {
    font-family: var(--font-tech);
    font-size: 10px;
    letter-spacing: 1.4px;
    color: var(--jarvis-text-muted);
    margin-bottom: 4px;
  }
  .telemetry-val {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }

  /* WhatsApp Conversion Button */
  .jarvis-btn-whatsapp {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff !important;
    box-shadow: 0 0 24px rgba(16, 185, 129, 0.55);
    border: 1px solid rgba(16, 185, 129, 0.9);
  }
  .jarvis-btn-whatsapp:hover {
    background: #ffffff;
    color: #047857 !important;
    box-shadow: 0 0 32px rgba(16, 185, 129, 0.85);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .hero-telemetry-grid {
      grid-template-columns: 1fr;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .jarvis-btn {
      justify-content: center;
    }
  }
</style>

<script>
  const roles = [
    'Aplicaciones Web & Plataformas Full Stack',
    'Apps Móviles en Google Play Store',
    'Automatización de Negocios con IA',
    'Pasarelas de Pago & APIs Escalables',
    'Modelos Predictivos & Machine Learning'
  ];

  let typerInitialized = false;
  function initTyper() {
    if (typerInitialized) return;
    const el = document.getElementById('hero-typewriter');
    if (!el) return;
    typerInitialized = true;

    let roleIdx = 0;
    let charIdx = roles[0].length;
    let isDeleting = true;

    function typeLoop() {
      const currentRole = roles[roleIdx];
      if (isDeleting) {
        charIdx--;
        el!.textContent = currentRole.substring(0, charIdx);
      } else {
        charIdx++;
        el!.textContent = currentRole.substring(0, charIdx);
      }

      let speed = isDeleting ? 32 : 65;

      if (!isDeleting && charIdx === currentRole.length) {
        speed = 2300;
        isDeleting = true;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        roleIdx = (roleIdx + 1) % roles.length;
        speed = 350;
      }

      setTimeout(typeLoop, speed);
    }

    setTimeout(typeLoop, 2200);
  }

  if (typeof window !== 'undefined') {
    initTyper();
    document.addEventListener('astro:page-load', initTyper);
  }
</script>
