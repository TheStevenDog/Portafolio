---
// Hero Section with Decrypting Typer & Biometric HUD
import { personalData } from '../data/cv.js';
---

<section id="hero" class="hero-section">
  <div class="jarvis-container hero-container">
    
    <div class="hero-content">
      <!-- Protocol Badge -->
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>PROTOCOLO J.A.R.V.I.S. // STARK-ID: SRL-2902</span>
      </div>

      <!-- Main Name -->
      <h1 class="hero-name" data-scramble="true">
        {personalData.name} {personalData.lastName}
      </h1>

      <!-- Subtitle Role -->
      <div class="hero-role-title">
        <span class="text-cyan">//</span> Ingeniero de Software &amp; Full Stack AI Developer
      </div>

      <!-- Typing Dynamic Role -->
      <div class="hero-typer-line">
        <span class="typer-prefix">Especialista en:</span>
        <span id="hero-typewriter" class="typer-dynamic">Desarrollo Full Stack</span>
        <span class="typer-cursor"></span>
      </div>

      <!-- Summary Paragraph -->
      <p class="hero-summary">
        {personalData.bioSummary}
      </p>

      <!-- Quick Telemetry Highlights -->
      <div class="hero-telemetry-grid">
        <div class="telemetry-box">
          <span class="telemetry-label">UBICACIÓN</span>
          <span class="telemetry-val">{personalData.location}</span>
        </div>
        <div class="telemetry-box highlight-gold">
          <span class="telemetry-label">PREMIO NACIONAL</span>
          <span class="telemetry-val">Top 3 Hackathon IA</span>
        </div>
        <div class="telemetry-box highlight-emerald">
          <span class="telemetry-label">DISPONIBILIDAD</span>
          <span class="telemetry-val">Production Ready</span>
        </div>
      </div>

      <!-- Hero Action CTA Group -->
      <div class="hero-actions">
        <a href="#projects" class="jarvis-btn jarvis-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>Explorar Proyectos</span>
        </a>
        <a href="#about" class="jarvis-btn jarvis-btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>Diagnóstico Biométrico</span>
        </a>
        <a href={personalData.socials.github} target="_blank" rel="noopener noreferrer" class="jarvis-btn jarvis-btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>GitHub Oficial</span>
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: 100px;
    padding-bottom: 60px;
    z-index: 2;
  }

  .hero-container {
    position: relative;
  }

  .hero-content {
    max-width: 820px;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid var(--jarvis-cyan);
    border-radius: 4px;
    font-family: var(--font-tech);
    font-size: 11px;
    color: var(--jarvis-cyan);
    letter-spacing: 1.5px;
    margin-bottom: 24px;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    background: var(--jarvis-cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--jarvis-cyan);
    animation: pulse-glow 1.5s infinite;
  }

  /* Name & Title */
  .hero-name {
    font-size: clamp(38px, 6vw, 64px);
    font-weight: 900;
    line-height: 1.1;
    color: #ffffff;
    text-shadow: 0 0 25px rgba(0, 240, 255, 0.45);
    margin-bottom: 12px;
    text-transform: uppercase;
  }
  .hero-role-title {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.5vw, 24px);
    font-weight: 600;
    color: var(--jarvis-cyan);
    letter-spacing: 1.5px;
    margin-bottom: 16px;
  }
  .text-cyan {
    color: var(--jarvis-cyan);
  }

  /* Typer Line */
  .hero-typer-line {
    font-family: var(--font-tech);
    font-size: clamp(16px, 2vw, 21px);
    color: var(--jarvis-text-main);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .typer-prefix {
    color: var(--jarvis-text-muted);
  }
  .typer-dynamic {
    color: #ffffff;
    font-weight: 700;
    text-shadow: 0 0 12px var(--jarvis-cyan-glow);
  }
  .typer-cursor {
    display: inline-block;
    width: 9px;
    height: 20px;
    background: var(--jarvis-cyan);
    animation: pulse-glow 0.8s infinite;
  }

  /* Summary */
  .hero-summary {
    font-size: 16px;
    line-height: 1.8;
    color: var(--jarvis-text-main);
    margin-bottom: 30px;
    max-width: 760px;
  }

  /* Telemetry Grid */
  .hero-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 36px;
  }
  .telemetry-box {
    background: rgba(5, 15, 34, 0.85);
    border: 1px solid var(--jarvis-border);
    backdrop-filter: blur(10px);
    padding: 12px 16px;
    border-radius: 4px;
    font-family: var(--font-tech);
  }
  .telemetry-label {
    display: block;
    font-size: 10px;
    color: var(--jarvis-cyan);
    letter-spacing: 1.5px;
    margin-bottom: 4px;
  }
  .telemetry-val {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
  }
  .highlight-gold {
    border-color: rgba(255, 190, 11, 0.5);
  }
  .highlight-gold .telemetry-label {
    color: var(--jarvis-gold);
  }
  .highlight-emerald {
    border-color: rgba(16, 185, 129, 0.5);
  }
  .highlight-emerald .telemetry-label {
    color: var(--jarvis-emerald);
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>

<script>
  // High-Tech Text Scramble & Role Typer
  const roles = [
    'Desarrollo Full Stack',
    'Automatización Asistida por IA',
    'Arquitectura Web Escalable',
    'Despliegues en Google Play Store',
    'Machine Learning & Software Predictivo'
  ];

  function initTyper() {
    const el = document.getElementById('hero-typewriter');
    if (!el) return;

    let roleIdx = 0;
    let charIdx = 0;
    let isDeleting = false;

    function typeLoop() {
      const currentRole = roles[roleIdx];

      if (isDeleting) {
        charIdx--;
        el.textContent = currentRole.substring(0, charIdx);
      } else {
        charIdx++;
        el.textContent = currentRole.substring(0, charIdx);
      }

      let speed = isDeleting ? 40 : 80;

      if (!isDeleting && charIdx === currentRole.length) {
        speed = 2200; // Pause at end of word
        isDeleting = true;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        roleIdx = (roleIdx + 1) % roles.length;
        speed = 400; // Pause before next word
      }

      setTimeout(typeLoop, speed);
    }

    typeLoop();
  }

  // Scramble Name Effect
  const SCRAMBLE_CHARS = '0123456789ABCDEF/\\#<>_%*+=-~[]';
  function initScramble() {
    document.querySelectorAll('[data-scramble="true"]').forEach((element) => {
      const finalPhrase = element.textContent.trim();
      let iteration = 0;
      const interval = setInterval(() => {
        element.textContent = finalPhrase
          .split('')
          .map((char, index) => {
            if (char === ' ' || char === '\n') return char;
            if (index < iteration / 2.5) return finalPhrase[index];
            return SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
          })
          .join('');

        iteration++;
        if (iteration >= finalPhrase.length * 2.5) {
          clearInterval(interval);
          element.textContent = finalPhrase;
        }
      }, 30);
    });
  }

  if (typeof window !== 'undefined') {
    initTyper();
    initScramble();
    document.addEventListener('astro:page-load', () => {
      initTyper();
      initScramble();
    });
  }
</script>
