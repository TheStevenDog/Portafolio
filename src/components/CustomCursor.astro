---
// 2026 Studio-Grade Custom Cursor (Skill Archetype 05 / Effects Catalog §1.1)
// Clean dual-circle with difference blend mode, lerp smoothing & holographic reticle
---

<div class="jarvis-cursor-root" data-cursor-root aria-hidden="true">
  <span class="cursor-dot"></span>
  <span class="cursor-ring"></span>
  <span class="cursor-telemetry" data-cursor-telemetry>SYS // READY</span>
</div>

<style>
  .jarvis-cursor-root {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 99999;
    display: none;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Only show on fine pointer desktop devices (Skill Gotcha) */
  @media (hover: hover) and (pointer: fine) {
    .jarvis-cursor-root {
      display: block;
    }
  }

  .jarvis-cursor-root.is-ready {
    opacity: 1;
  }

  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    margin: -3px;
    background: var(--jarvis-cyan, #00f0ff);
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.9);
    transition: transform 0.05s linear, width 0.2s, height 0.2s, margin 0.2s, background-color 0.2s;
  }

  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 34px;
    height: 34px;
    margin: -17px;
    border: 1px solid rgba(0, 240, 255, 0.6);
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                margin 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s,
                box-shadow 0.25s,
                background 0.25s;
  }

  /* Crosshair reticle accents on ring */
  .cursor-ring::before,
  .cursor-ring::after {
    content: "";
    position: absolute;
    background: rgba(0, 240, 255, 0.5);
    pointer-events: none;
    transition: opacity 0.25s;
  }
  .cursor-ring::before {
    top: 50%;
    left: -4px;
    right: -4px;
    height: 1px;
    transform: translateY(-50%);
    opacity: 0.4;
  }
  .cursor-ring::after {
    left: 50%;
    top: -4px;
    bottom: -4px;
    width: 1px;
    transform: translateX(-50%);
    opacity: 0.4;
  }

  /* Telemetry coordinates badge (Skill Catalog §1.3 adapted for Stark HUD) */
  .cursor-telemetry {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    font-family: var(--font-tech, monospace);
    font-size: 9px;
    letter-spacing: 1.5px;
    color: var(--jarvis-cyan, #00f0ff);
    background: rgba(2, 6, 18, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.35);
    border-radius: 2px;
    padding: 2px 6px;
    transform: translate(22px, 14px);
    white-space: nowrap;
    opacity: 0.8;
    backdrop-filter: blur(4px);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.15);
  }

  /* Interactive hover state when over buttons, links, cards */
  .jarvis-cursor-root.is-interactive .cursor-ring {
    width: 52px;
    height: 52px;
    margin: -26px;
    border-color: #ffffff;
    box-shadow: 0 0 18px rgba(0, 240, 255, 0.4);
    background: rgba(0, 240, 255, 0.06);
  }
  .jarvis-cursor-root.is-interactive .cursor-dot {
    background: #ffffff;
    box-shadow: 0 0 12px #ffffff;
    transform: scale(1.4);
  }
  .jarvis-cursor-root.is-interactive .cursor-telemetry {
    border-color: var(--jarvis-cyan);
    color: #ffffff;
  }

  /* Hide default cursor on interactive targets when custom cursor is active */
  :global(html.has-custom-cursor),
  :global(html.has-custom-cursor a),
  :global(html.has-custom-cursor button),
  :global(html.has-custom-cursor input),
  :global(html.has-custom-cursor textarea),
  :global(html.has-custom-cursor [data-cursor]) {
    cursor: none !important;
  }
</style>

<script>
  function initJarvisCursor() {
    const root = document.querySelector('[data-cursor-root]');
    if (!root || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.documentElement.classList.add('has-custom-cursor');
    const ring = root.querySelector('.cursor-ring');
    const dot = root.querySelector('.cursor-dot');
    const telemetry = root.querySelector('[data-cursor-telemetry]');

    let targetX = -100;
    let targetY = -100;
    let ringX = -100;
    let ringY = -100;
    let isReady = false;
    let lastTelemetryUpdate = 0;

    window.addEventListener('mousemove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;

      if (dot) {
        dot.style.transform = `translate3d(${targetX}px, ${targetY}px, 0)`;
      }

      if (!isReady) {
        isReady = true;
        ringX = targetX;
        ringY = targetY;
        if (ring) ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
        if (telemetry) telemetry.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(22px, 14px)`;
        root.classList.add('is-ready');
      }

      // Throttle telemetry text coordinate update to ~15fps for performance
      const now = performance.now();
      if (telemetry && now - lastTelemetryUpdate > 65) {
        lastTelemetryUpdate = now;
        telemetry.textContent = `LOC // [${Math.round(targetX)}, ${Math.round(targetY)}]`;
      }
    }, { passive: true });

    function tick() {
      if (isReady && ring) {
        // High quality lerp smoothing (Skill Catalog §1.1)
        ringX += (targetX - ringX) * 0.18;
        ringY += (targetY - ringY) * 0.18;
        ring.style.transform = `translate3d(${ringX.toFixed(2)}px, ${ringY.toFixed(2)}px, 0)`;
        if (telemetry) {
          telemetry.style.transform = `translate3d(${ringX.toFixed(2)}px, ${ringY.toFixed(2)}px, 0) translate(22px, 14px)`;
        }
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    // Interactive Hover Elements (Catalog §1.1)
    const HOVERABLES = 'a, button, [data-cursor], .hud-card, .stat-card, .filter-tab-btn, .jarvis-btn, input, textarea';
    
    document.addEventListener('mouseover', (e) => {
      if (e.target && e.target.closest(HOVERABLES)) {
        root.classList.add('is-interactive');
      }
    }, { passive: true });

    document.addEventListener('mouseout', (e) => {
      if (e.target && e.target.closest(HOVERABLES)) {
        if (!e.relatedTarget || !e.relatedTarget.closest(HOVERABLES)) {
          root.classList.remove('is-interactive');
        }
      }
    }, { passive: true });

    // Hide cursor when leaving window
    document.addEventListener('mouseleave', () => {
      root.classList.remove('is-ready');
    });
    document.addEventListener('mouseenter', () => {
      if (isReady) root.classList.add('is-ready');
    });
  }

  // Initialize safely
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initJarvisCursor);
    } else {
      initJarvisCursor();
    }
    document.addEventListener('astro:page-load', initJarvisCursor);
  }
</script>
