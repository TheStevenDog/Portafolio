---
// Global 18-Agent Swarm with Real-Time Progressive Drag-Box Reveal
// 18 Autonomous AI Agent Cursors working simultaneously across the entire page.
// As each agent drags a selection square over an element, the text and UI inside
// progressively materialize in real time synchronized with the dragged box!
---

<div class="agent-swarm-stage" id="global-agent-stage" aria-hidden="true"></div>

<!-- Floating Global Swarm Controller Pill -->
<button
  type="button"
  id="global-replay-agents-btn"
  class="global-agent-controller"
  title="Reconstruir toda la página con el enjambre de 18 Agentes IA"
>
  <span class="controller-dot is-building" id="global-agent-dot"></span>
  <span id="global-agent-status-text">18 AGENTES IA // ENJAMBRE ACTIVO</span>
  <span class="controller-replay-tag">↻ Replay</span>
</button>

<style is:global>
  /* =========================================================================
     PROGRESSIVE DRAG-SQUARE REVEAL SYSTEM (Across All Elements on the Page)
  ========================================================================= */
  [data-swarm-target] {
    position: relative;
  }

  /* Blueprint placeholder frame visible before & during the agent's drag reveal */
  [data-swarm-target].is-unbuilt,
  [data-swarm-target].is-drawing {
    --reveal-x: 0%;
    --reveal-y: 0%;
    --agent-color: #00f0ff;
  }

  /* While waiting for an agent to arrive: content is hidden inside the 0x0 clip box,
     leaving a subtle dashed blueprint slot so the layout never jumps */
  [data-swarm-target].is-unbuilt {
    clip-path: polygon(0 0, 0 0, 0 0, 0 0);
  }

  /* While the agent is dragging its square from top-left to bottom-right:
     the element & its text reveal progressively inside the exact rectangle [0..--reveal-x, 0..--reveal-y]! */
  [data-swarm-target].is-drawing {
    clip-path: polygon(
      0% 0%,
      var(--reveal-x, 100%) 0%,
      var(--reveal-x, 100%) var(--reveal-y, 100%),
      0% var(--reveal-y, 100%)
    );
    will-change: clip-path;
  }

  /* Completed state: full visibility, no clip-path restriction */
  [data-swarm-target].is-built {
    clip-path: none !important;
    animation: swarmBuildComplete 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes swarmBuildComplete {
    0% {
      filter: brightness(1.35) drop-shadow(0 0 14px var(--agent-color, #00f0ff));
    }
    100% {
      filter: none;
    }
  }

  /* Agent Stage & 18 Cursors + 18 Individual Drag Selection Boxes */
  .agent-swarm-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9000;
    overflow: hidden;
  }

  .swarm-agent-unit {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9005;
  }

  /* Each Agent's Live Dragged Selection Square */
  .swarm-drag-box {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border: 1.5px dashed var(--agent-color, #00f0ff);
    background: var(--agent-bg, rgba(0, 240, 255, 0.07));
    box-shadow: inset 0 0 16px var(--agent-bg, rgba(0, 240, 255, 0.12)),
                0 0 12px var(--agent-bg, rgba(0, 240, 255, 0.15));
    pointer-events: none;
    opacity: 0;
    z-index: 9002;
    transition: opacity 0.15s ease;
    will-change: transform, width, height;
  }
  .swarm-drag-box.is-visible {
    opacity: 1;
  }

  /* Corner handles on each agent's selection square */
  .swarm-drag-box::before,
  .swarm-drag-box::after {
    content: "";
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--agent-color, #00f0ff);
  }
  .swarm-drag-box::before {
    top: -3px;
    left: -3px;
  }
  .swarm-drag-box::after {
    bottom: -3px;
    right: -3px;
  }

  .swarm-box-dim {
    position: absolute;
    top: -17px;
    left: 0;
    background: var(--agent-color, #00f0ff);
    color: #020612;
    font-family: var(--font-tech, monospace);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 1px 5px;
    border-radius: 2px;
    white-space: nowrap;
  }

  /* Each Agent's Pointer Cursor */
  .swarm-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    will-change: transform, opacity;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 9006;
    filter: drop-shadow(0 5px 12px rgba(0, 0, 0, 0.8));
  }
  .swarm-cursor.is-active {
    opacity: 1;
  }

  .swarm-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 12px;
    margin-top: -4px;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--agent-color, #00f0ff);
    color: #020612;
    font-family: var(--font-tech, monospace);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.8px;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.65);
  }
  .swarm-task {
    font-weight: 600;
    opacity: 0.88;
    padding-left: 4px;
    border-left: 1px solid rgba(2, 6, 18, 0.3);
  }
</style>

<style>
  /* Floating Global Agent Controller Pill */
  .global-agent-controller {
    position: fixed;
    bottom: 54px;
    left: 28px;
    z-index: 1040;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 13px;
    background: rgba(3, 10, 24, 0.88);
    border: 1px solid rgba(0, 240, 255, 0.4);
    border-radius: 999px;
    backdrop-filter: blur(10px);
    font-family: var(--font-tech, monospace);
    font-size: 10px;
    letter-spacing: 1.2px;
    color: #00f0ff;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.65);
    transition: all 0.25s ease;
  }
  .global-agent-controller:hover {
    border-color: #ffbe0b;
    color: #ffffff;
    box-shadow: 0 0 20px rgba(255, 190, 11, 0.4);
    transform: translateY(-2px);
  }
  .controller-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }
  .controller-dot.is-building {
    background: #ffbe0b;
    box-shadow: 0 0 10px #ffbe0b;
    animation: pulse-glow 0.8s infinite;
  }
  .controller-replay-tag {
    background: rgba(255, 190, 11, 0.16);
    color: #ffbe0b;
    padding: 1px 7px;
    border-radius: 999px;
    font-weight: 700;
    margin-left: 2px;
  }

  @media (max-width: 768px) {
    .global-agent-controller {
      bottom: 16px;
      left: 14px;
      padding: 6px 10px;
      font-size: 9px;
    }
  }
</style>

<script>
  function initSwarm18Engine() {
    const stage = document.getElementById('global-agent-stage');
    if (!stage) return;
    stage.innerHTML = '';

    const heroReplayLabel = document.getElementById('replay-agents-label');
    const globalStatusText = document.getElementById('global-agent-status-text');
    const globalDot = document.getElementById('global-agent-dot');

    // =========================================================================
    // 1. DEFINE THE 18 SIMULTANEOUS AI AGENTS
    // =========================================================================
    const SWARM_ROSTER = [
      { id: 'ARCH_01',   color: '#00f0ff', bg: 'rgba(0, 240, 255, 0.08)' },
      { id: 'COPY_02',   color: '#10b981', bg: 'rgba(16, 185, 129, 0.08)' },
      { id: 'UI_03',     color: '#ffbe0b', bg: 'rgba(255, 190, 11, 0.08)' },
      { id: '3D_CORE',   color: '#c084fc', bg: 'rgba(192, 132, 252, 0.08)' },
      { id: 'LAYOUT_05', color: '#38bdf8', bg: 'rgba(56, 189, 248, 0.08)' },
      { id: 'STYLE_06',  color: '#f472b6', bg: 'rgba(244, 114, 182, 0.08)' },
      { id: 'TYPE_07',   color: '#34d399', bg: 'rgba(52, 211, 153, 0.08)' },
      { id: 'GRID_08',   color: '#fb923c', bg: 'rgba(251, 146, 60, 0.08)' },
      { id: 'PIXEL_09',  color: '#a3e635', bg: 'rgba(163, 230, 53, 0.08)' },
      { id: 'NODE_10',   color: '#60a5fa', bg: 'rgba(96, 165, 250, 0.08)' },
      { id: 'SHADER_11', color: '#e879f9', bg: 'rgba(232, 121, 249, 0.08)' },
      { id: 'FLOW_12',   color: '#2dd4bf', bg: 'rgba(45, 212, 191, 0.08)' },
      { id: 'DATA_13',   color: '#facc15', bg: 'rgba(250, 204, 21, 0.08)' },
      { id: 'UX_14',     color: '#fb7185', bg: 'rgba(251, 113, 133, 0.08)' },
      { id: 'MOTION_15', color: '#818cf8', bg: 'rgba(129, 140, 248, 0.08)' },
      { id: 'API_16',    color: '#4ade80', bg: 'rgba(74, 222, 128, 0.08)' },
      { id: 'DOM_17',    color: '#22d3ee', bg: 'rgba(34, 211, 238, 0.08)' },
      { id: 'DEPLOY_18', color: '#f97316', bg: 'rgba(249, 115, 22, 0.08)' }
    ];

    interface SwarmAgent {
      index: number;
      name: string;
      color: string;
      bg: string;
      cursorEl: HTMLElement;
      taskEl: HTMLElement;
      boxEl: HTMLElement;
      dimEl: HTMLElement;
      x: number;
      y: number;
      state: 'IDLE' | 'FLYING_TO_START' | 'DRAGGING_BOX';
      targetEl: HTMLElement | null;
      flyStartX: number;
      flyStartY: number;
      ctrlX: number;
      ctrlY: number;
      phaseStart: number;
      flyDuration: number;
      dragDuration: number;
      lastActiveTime: number;
    }

    const vw = () => window.innerWidth;
    const vh = () => window.innerHeight;

    // Create DOM nodes for all 18 agents and their 18 drag selection squares
    const agents: SwarmAgent[] = SWARM_ROSTER.map((cfg, idx) => {
      // Selection box for this agent
      const boxEl = document.createElement('div');
      boxEl.className = 'swarm-drag-box';
      boxEl.style.setProperty('--agent-color', cfg.color);
      boxEl.style.setProperty('--agent-bg', cfg.bg);
      const dimEl = document.createElement('span');
      dimEl.className = 'swarm-box-dim';
      dimEl.textContent = `${cfg.id} // 0×0`;
      boxEl.appendChild(dimEl);
      stage.appendChild(boxEl);

      // Cursor for this agent
      const cursorEl = document.createElement('div');
      cursorEl.className = 'swarm-cursor';
      cursorEl.style.setProperty('--agent-color', cfg.color);
      cursorEl.innerHTML = `
        <svg width="16" height="20" viewBox="0 0 18 22" fill="none">
          <path d="M1.5 1.5L16 10.5L9.2 12.2L6.5 19.5L1.5 1.5Z" fill="${cfg.color}" stroke="#020612" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
        <div class="swarm-badge">
          <span>${cfg.id}</span>
          <span class="swarm-task">READY</span>
        </div>
      `;
      stage.appendChild(cursorEl);
      const taskEl = cursorEl.querySelector('.swarm-task') as HTMLElement;

      // Spawn around screen perimeter
      const angle = (idx / SWARM_ROSTER.length) * Math.PI * 2;
      const initX = vw() * 0.5 + Math.cos(angle) * (vw() * 0.55);
      const initY = vh() * 0.5 + Math.sin(angle) * (vh() * 0.55);
      cursorEl.style.transform = `translate3d(${initX.toFixed(1)}px, ${initY.toFixed(1)}px, 0)`;

      return {
        index: idx,
        name: cfg.id,
        color: cfg.color,
        bg: cfg.bg,
        cursorEl,
        taskEl,
        boxEl,
        dimEl,
        x: initX,
        y: initY,
        state: 'IDLE',
        targetEl: null,
        flyStartX: initX,
        flyStartY: initY,
        ctrlX: initX,
        ctrlY: initY,
        phaseStart: 0,
        flyDuration: 360,
        dragDuration: 680,
        lastActiveTime: 0
      };
    });

    // =========================================================================
    // 2. GRANULAR TARGET DISCOVERY ACROSS EVERY SECTION OF THE WEBSITE
    // =========================================================================
    const GRANULAR_SELECTORS = [
      // Hero granular elements
      '#hero .hero-badge',
      '#hero .title-stroke',
      '#hero .title-solid',
      '#hero .title-accent',
      '#hero .hero-typer-line',
      '#hero .hero-summary',
      '#hero .telemetry-box',
      '#hero .hero-actions .jarvis-btn',
      // About granular elements
      '#about .section-tag',
      '#about .section-title',
      '#about .section-subtitle',
      '#about .bio-avatar-col',
      '#about .bio-headline',
      '#about .bio-desc',
      '#about .matrix-card',
      '#about .stat-card',
      // Services granular elements
      '#services .expertise-marquee-wrap',
      '#services .section-tag',
      '#services .section-title',
      '#services .section-subtitle',
      '#services .expertise-col',
      '#services .process-strip-header',
      '#services .process-step-card',
      // Projects granular elements
      '#projects .section-tag',
      '#projects .section-title',
      '#projects .section-subtitle',
      '#projects .filter-tab-btn',
      '#projects .project-card',
      // Skills granular elements
      '#skills .section-tag',
      '#skills .section-title',
      '#skills .section-subtitle',
      '#skills .skill-card',
      // Experience granular elements
      '#experience .section-tag',
      '#experience .section-title',
      '#experience .section-subtitle',
      '#experience .col-title',
      '#experience .mission-item',
      '#experience .cert-card',
      // Contact granular elements
      '#contact .work-with-us-label',
      '#contact .editorial-contact-heading',
      '#contact .giant-contact-link',
      '#contact .contact-info-title',
      '#contact .contact-item',
      '#contact .contact-form-card .form-group',
      '#contact .contact-form-card .jarvis-btn'
    ];

    let allTargets: HTMLElement[] = [];
    const buildQueue: HTMLElement[] = [];
    const queuedSet = new Set<HTMLElement>();

    function collectAndResetAllTargets() {
      buildQueue.length = 0;
      queuedSet.clear();

      // Free all agents
      agents.forEach((a) => {
        a.state = 'IDLE';
        a.targetEl = null;
        a.boxEl.classList.remove('is-visible');
      });

      const found = new Set<HTMLElement>();
      GRANULAR_SELECTORS.forEach((sel) => {
        document.querySelectorAll(sel).forEach((node) => {
          found.add(node as HTMLElement);
        });
      });

      allTargets = Array.from(found);
      allTargets.forEach((el) => {
        el.setAttribute('data-swarm-target', 'true');
        el.classList.remove('is-built', 'is-drawing');
        el.classList.add('is-unbuilt');
        el.style.setProperty('--reveal-x', '0%');
        el.style.setProperty('--reveal-y', '0%');
      });
    }

    collectAndResetAllTargets();

    // =========================================================================
    // 3. SWARM TASK DISPATCHER & INTERSECTION OBSERVER
    // =========================================================================
    function enqueueTarget(el: HTMLElement) {
      if (queuedSet.has(el) || el.classList.contains('is-built')) return;
      queuedSet.add(el);
      buildQueue.push(el);
    }

    function assignNextTasks(now: number) {
      if (buildQueue.length === 0) return;

      // Sort queue so elements currently visible in viewport are prioritized top-to-bottom
      for (const agent of agents) {
        if (agent.state !== 'IDLE') continue;
        if (buildQueue.length === 0) break;

        // Pick the first unbuilt target in queue that has non-zero dimensions
        let pickedIdx = -1;
        for (let i = 0; i < buildQueue.length; i++) {
          const candidate = buildQueue[i];
          const r = candidate.getBoundingClientRect();
          // Prioritize visible or near-viewport elements
          if (r.width > 4 && r.height > 4 && r.bottom > -120 && r.top < vh() + 260) {
            pickedIdx = i;
            break;
          }
        }

        if (pickedIdx === -1) continue;

        const targetEl = buildQueue.splice(pickedIdx, 1)[0];
        const r = targetEl.getBoundingClientRect();

        agent.targetEl = targetEl;
        agent.state = 'FLYING_TO_START';
        agent.flyStartX = agent.x;
        agent.flyStartY = agent.y;

        // Top-left corner of target element
        const destX = Math.max(8, Math.min(vw() - 40, r.left));
        const destY = Math.max(8, Math.min(vh() - 30, r.top));
        agent.ctrlX = (agent.flyStartX + destX) * 0.5 + (Math.random() - 0.5) * 90;
        agent.ctrlY = (agent.flyStartY + destY) * 0.5 - 45;

        agent.phaseStart = now;
        agent.flyDuration = 240 + (agent.index % 5) * 45;
        // Larger elements take slightly longer to drag-reveal smoothly
        const areaFactor = Math.min(1.4, Math.max(0.75, Math.sqrt(r.width * r.height) / 220));
        agent.dragDuration = Math.round(520 * areaFactor + (agent.index % 4) * 40);
        agent.lastActiveTime = now;

        agent.cursorEl.classList.add('is-active');
        agent.taskEl.textContent = 'LOCATING';
        targetEl.style.setProperty('--agent-color', agent.color);
      }
    }

    // Observe all granular elements as user scrolls
    const targetObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            enqueueTarget(entry.target as HTMLElement);
          }
        });
      },
      {
        threshold: 0.05,
        rootMargin: '80px 0px 140px 0px'
      }
    );

    function observeAllTargets() {
      targetObserver.disconnect();
      allTargets.forEach((el) => targetObserver.observe(el));

      // Also immediately enqueue everything currently in viewport
      allTargets.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < vh() + 120 && r.bottom > -50) {
          enqueueTarget(el);
        }
      });
    }

    observeAllTargets();

    // =========================================================================
    // 4. MASTER 60FPS ANIMATION LOOP: FLY -> DRAG SQUARE & PROGRESSIVE REVEAL
    // =========================================================================
    function updateStatusUI(activeCount: number) {
      const isWorking = activeCount > 0;
      if (globalDot) globalDot.classList.toggle('is-building', isWorking);
      if (globalStatusText) {
        globalStatusText.textContent = isWorking
          ? `18 AGENTES IA // CONSTRUYENDO (${activeCount} ACTIVOS)`
          : '18 AGENTES IA // PÁGINA CONSTRUIDA ✓';
      }
      if (heroReplayLabel) {
        heroReplayLabel.textContent = isWorking
          ? `18 Agentes Construyendo...`
          : '⚡ Replay 18 Agentes IA';
      }
    }

    function tick(now: number) {
      assignNextTasks(now);

      let activeAgentsCount = 0;

      for (const agent of agents) {
        if (agent.state === 'FLYING_TO_START' && agent.targetEl) {
          activeAgentsCount++;
          agent.lastActiveTime = now;

          const r = agent.targetEl.getBoundingClientRect();
          const startCornerX = Math.max(8, Math.min(vw() - 30, r.left));
          const startCornerY = Math.max(8, Math.min(vh() - 25, r.top));

          const elapsed = now - agent.phaseStart;
          const t = Math.min(1, Math.max(0, elapsed / agent.flyDuration));
          const ease = 1 - Math.pow(1 - t, 3);
          const inv = 1 - ease;

          agent.x = inv * inv * agent.flyStartX + 2 * inv * ease * agent.ctrlX + ease * ease * startCornerX;
          agent.y = inv * inv * agent.flyStartY + 2 * inv * ease * agent.ctrlY + ease * ease * startCornerY;
          agent.cursorEl.style.transform = `translate3d(${agent.x.toFixed(1)}px, ${agent.y.toFixed(1)}px, 0)`;

          if (t >= 1) {
            // Arrived at top-left corner! Start dragging selection square & progressively revealing content!
            agent.state = 'DRAGGING_BOX';
            agent.phaseStart = now;
            agent.taskEl.textContent = 'DRAWING';
            agent.targetEl.classList.remove('is-unbuilt');
            agent.targetEl.classList.add('is-drawing');
            agent.boxEl.classList.add('is-visible');
          }
        } else if (agent.state === 'DRAGGING_BOX' && agent.targetEl) {
          activeAgentsCount++;
          agent.lastActiveTime = now;

          const r = agent.targetEl.getBoundingClientRect();
          const elapsed = now - agent.phaseStart;
          const rawT = Math.min(1, Math.max(0, elapsed / agent.dragDuration));
          // Smooth cubic ease-out for dragging the box open
          const p = 1 - Math.pow(1 - rawT, 2.4);

          // Width goes slightly ahead of height for natural marquee drag feel
          const px = Math.min(1, p * 1.06);
          const py = p;

          const curW = Math.max(6, r.width * px);
          const curH = Math.max(6, r.height * py);

          // Position the agent's dragged square over the live element
          agent.boxEl.style.transform = `translate3d(${r.left.toFixed(1)}px, ${r.top.toFixed(1)}px, 0)`;
          agent.boxEl.style.width = `${curW.toFixed(1)}px`;
          agent.boxEl.style.height = `${curH.toFixed(1)}px`;
          agent.dimEl.textContent = `${agent.name} // ${Math.round(curW)}×${Math.round(curH)}`;

          // Move the agent cursor right along the bottom-right corner of the expanding square!
          agent.x = Math.max(8, Math.min(vw() - 40, r.left + curW));
          agent.y = Math.max(8, Math.min(vh() - 24, r.top + curH));
          agent.cursorEl.style.transform = `translate3d(${agent.x.toFixed(1)}px, ${agent.y.toFixed(1)}px, 0)`;

          // PROGRESSIVELY REVEAL THE TEXT & ELEMENT INSIDE THE SQUARE AS IT EXPANDS!
          const pctX = (px * 100).toFixed(1) + '%';
          const pctY = (py * 100).toFixed(1) + '%';
          agent.targetEl.style.setProperty('--reveal-x', pctX);
          agent.targetEl.style.setProperty('--reveal-y', pctY);

          if (rawT >= 1) {
            // Finished drawing this element! Lock it at 100% visibility
            agent.targetEl.classList.remove('is-drawing', 'is-unbuilt');
            agent.targetEl.classList.add('is-built');
            agent.boxEl.classList.remove('is-visible');
            agent.taskEl.textContent = 'BUILT ✓';
            agent.targetEl = null;
            agent.state = 'IDLE';
          }
        } else {
          // IDLE: Hide cursor after 650ms of inactivity so screen stays clean once built
          if (now - agent.lastActiveTime > 650) {
            agent.cursorEl.classList.remove('is-active');
          }
        }
      }

      // If any targets are off-screen above current scroll, mark them built or enqueue when scrolled
      updateStatusUI(activeAgentsCount);
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);

    // Also re-check visible unbuilt elements on scroll so rapid scrolling dispatches the 18 agents immediately
    window.addEventListener(
      'scroll',
      () => {
        for (const el of allTargets) {
          if (el.classList.contains('is-unbuilt') && !queuedSet.has(el)) {
            const r = el.getBoundingClientRect();
            if (r.top < vh() + 150 && r.bottom > -60) {
              enqueueTarget(el);
            }
          }
        }
      },
      { passive: true }
    );

    // =========================================================================
    // 5. FULL-PAGE 18-AGENT SWARM REPLAY TRIGGER
    // =========================================================================
    function triggerSwarmReplay() {
      if (typeof (window as any).triggerReactorAssemble === 'function') {
        (window as any).triggerReactorAssemble();
      }
      collectAndResetAllTargets();
      observeAllTargets();
    }

    const heroReplayBtn = document.getElementById('replay-agents-btn');
    if (heroReplayBtn) {
      heroReplayBtn.addEventListener('click', triggerSwarmReplay);
    }

    const globalReplayBtn = document.getElementById('global-replay-agents-btn');
    if (globalReplayBtn) {
      globalReplayBtn.addEventListener('click', triggerSwarmReplay);
    }
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSwarm18Engine);
    } else {
      initSwarm18Engine();
    }
    document.addEventListener('astro:page-load', initSwarm18Engine);
  }
</script>
