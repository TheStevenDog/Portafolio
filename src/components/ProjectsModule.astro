---
// GitHub Projects & Blueprints Component
import { projects, projectCategories } from '../data/projects.js';
---

<section id="projects" class="jarvis-section">
  <div class="jarvis-container">
    
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">Módulo 03 // Planos de Ingeniería &amp; GitHub</span>
      <h2 class="section-title">Proyectos &amp; Repositorios</h2>
      <p class="section-subtitle">
        Sistemas de software verificados y código fuente extraído directamente de <strong>GitHub (@TheStevenDog // Slise.Dev)</strong>.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="projects-filter-bar">
      {projectCategories.map((cat, idx) => (
        <button 
          class={`filter-tab-btn ${idx === 0 ? 'active' : ''}`}
          data-category={cat.id}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid" id="projects-container">
      {projects.map((proj) => (
        <article class="hud-card project-card" data-cat={proj.category}>
          <!-- Header Code -->
          <div class="hud-card-header">
            <span>[PROJECT_ID // {proj.id.toUpperCase()}]</span>
            <span class="jarvis-badge jarvis-badge-cyan">{proj.badge}</span>
          </div>

          <!-- Project Title -->
          <h3 class="project-title">{proj.title}</h3>

          <!-- Description -->
          <p class="project-desc">{proj.description}</p>

          <!-- Tech Tags -->
          <div class="project-tags">
            {proj.tags.map((tag) => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>

          <!-- Action Links -->
          <div class="project-links">
            <a href={proj.github} target="_blank" rel="noopener noreferrer" class="jarvis-btn jarvis-btn-primary proj-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Ver en GitHub</span>
            </a>

            {proj.apiGithub && (
              <a href={proj.apiGithub} target="_blank" rel="noopener noreferrer" class="jarvis-btn jarvis-btn-outline proj-btn">
                <span>API Backend</span>
              </a>
            )}
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /* Filter Bar */
  .projects-filter-bar {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .filter-tab-btn {
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid var(--jarvis-border);
    color: var(--jarvis-text-muted);
    font-family: var(--font-tech);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 20px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .filter-tab-btn:hover,
  .filter-tab-btn.active {
    background: var(--jarvis-cyan);
    color: #020612;
    border-color: var(--jarvis-cyan);
    box-shadow: 0 0 16px var(--jarvis-cyan-glow);
  }

  /* Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 24px;
  }

  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: all 0.35s ease;
  }
  .project-card.is-hidden {
    display: none;
  }

  .project-title {
    font-size: 19px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .project-desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--jarvis-text-main);
    margin-bottom: 20px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
    margin-top: auto;
  }
  .tag-pill {
    background: rgba(0, 240, 255, 0.14);
    border: 1px solid rgba(0, 240, 255, 0.4);
    color: #ffffff;
    font-family: var(--font-tech);
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 2px;
  }

  .project-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .proj-btn {
    padding: 8px 16px;
    font-size: 11px;
  }
</style>

<script>
  function setupProjectFilters() {
    const filterBtns = document.querySelectorAll('.filter-tab-btn');
    const cards = document.querySelectorAll('.project-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const cat = btn.getAttribute('data-category');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat');
          if (cat === 'all' || cardCat === cat) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  }

  if (typeof window !== 'undefined') {
    setupProjectFilters();
    document.addEventListener('astro:page-load', setupProjectFilters);
  }
</script>
